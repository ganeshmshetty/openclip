{
  "safety-guardrail": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./.agents/hooks/safety_guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "post-file-change": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./.agents/hooks/post_file_change.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
