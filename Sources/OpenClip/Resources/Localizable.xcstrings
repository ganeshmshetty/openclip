        }
      }
    },
    "This action is a standalone script file with no editable manifest. Re-create it as an extension package to customize its behavior.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此动作是独立脚本文件，没有可编辑的清单。请将其重建为扩展包后再自定义行为。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此動作為獨立的腳本檔案，沒有可編輯的資訊清單。請將其重新建立為擴充功能套件以自訂其行為。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est un fichier de script autonome sans manifeste modifiable. Recréez-la sous forme de paquet d’extension pour personnaliser son comportement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアクションは編集可能なマニフェストを持たない単体スクリプトファイルです。動作をカスタマイズするには拡張機能パッケージとして再作成してください。"
          }
        }
      }
    },
    "This action is backed by a standalone script file with no editable manifest, so changes cannot be saved here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此动作由独立脚本文件支持且没有可编辑的清单，因此无法在此保存更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此動作由獨立腳本檔案支援且沒有可編輯的資訊清單，因此無法在此儲存變更。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action repose sur un fichier de script autonome sans manifeste modifiable ; les modifications ne peuvent donc pas être enregistrées ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアクションは編集可能なマニフェストを持たない単体スクリプトファイルに基づいているため、ここでの変更は保存できません。"
          }
        }
      }
    },
    "This action needs configuration before it can run.": {
