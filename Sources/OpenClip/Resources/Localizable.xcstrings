    "Condense this text to be significantly shorter while keeping all essential information, the original language, and the tone. Preserve the overall formatting such as paragraphs and lists": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大幅精简这段文本，同时保留所有关键信息、原有语言和语气。保持段落、列表等整体格式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大幅精簡這段文字，同時保留所有關鍵資訊、原有語言與語氣。保持段落、清單等整體格式"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Condenser ce texte pour le rendre nettement plus court tout en conservant toutes les informations essentielles, la langue d’origine et le ton. Préserver la mise en forme générale (paragraphes, listes)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
