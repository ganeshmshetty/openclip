    "Explain what the text means in clear, simple language, in the same language as the text. Cover the core idea and any important details a beginner would need": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用与原文相同的语言，以清晰简单的措辞解释这段文本的含义。涵盖核心概念以及初学者需要了解的重要细节"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用與原文相同的語言，以清晰簡單的文字解釋這段文字的含義。涵蓋核心概念以及初學者需要知道的重要細節"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Expliquer ce que signifie le texte dans un langage clair et simple, dans la même langue que le texte. Couvrir l’idée principale et les détails importants qu’un débutant devrait connaître"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストと同じ言語で、わかりやすい言葉でテキストの意味を説明します。核心的な考え方と、初心者に必要な重要な詳細をカバーしてください"
          }
        }
      }
    },
